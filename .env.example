# slack-agent-controller configuration.
# Copy to ~/.config/slack-agent-controller/env and `chmod 600` it: the bot refuses to start if the
# file can be read by other users. Values may be followed by `# comments`.

# ---- Slack (api.slack.com/apps -> your app) ---------------------------------------------------
SLACK_BOT_TOKEN=xoxb-REPLACE_ME          # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-REPLACE_ME          # Basic Information -> App-Level Tokens (scope connections:write)
ALLOWED_SLACK_USER_IDS=U0123456789       # your Slack member ID(s); everyone else is ignored and logged
ALLOWED_CHANNEL_IDS=                     # optional private channel IDs the bot also listens in

# ---- Model provider: pick ONE --------------------------------------------------------------------
# Amazon Bedrock
PROVIDER=bedrock
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=REPLACE_ME      # Bedrock API key (or use AWS_PROFILE / AWS_ACCESS_KEY_ID+AWS_SECRET_ACCESS_KEY)
# Optional Bedrock model mapping for the opus/sonnet/haiku aliases (settings files are NOT loaded):
# ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-opus-5-5[1m]
# ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-5-5

# Anthropic API (instead of the Bedrock block above)
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# claude.ai login (CLAUDE_CODE_OAUTH_TOKEN) is not supported: Anthropic does not allow it for
# third-party tools built on the Agent SDK.
API_KEY_EXPIRES=                         # optional YYYY-MM-DD: DM reminder 3 days before the key expires
CLAUDE_MODEL=sonnet                      # opus | sonnet | haiku | full model id; empty = Claude Code default
DEFAULT_EFFORT=                          # low|medium|high|xhigh|max; empty = Claude Code default (per thread: !effort)

# ---- Where sessions may work ----------------------------------------------------------------------
CWD_ROOTS=~                              # comma-separated; sessions and jobs may only run under these
DEFAULT_CWD=~                            # directory for sessions started without `!new <dir>`
PROJECTS=                                # alias=dir,...  e.g. web=~/code/webapp,ml=~/research/model
NODE_NAME=                               # shown in messages; default: the host name

# ---- Permissions -------------------------------------------------------------------------------------
DEFAULT_PERMISSION_MODE=ask              # ask = approve with buttons; auto = Claude Code's auto-mode classifier
                                         # (protected files, credentials, network and env dumps still ask). Per thread: !mode
LEARN_APPROVED_COMMANDS=1                # remember eligible Bash commands you approve (exact text + directory); !allowlist
APPROVAL_TIMEOUT_SEC=1800                # unanswered approvals and questions are denied after this
EXTRA_SENSITIVE_PATHS=                   # extra paths Claude may never read or write (comma-separated)
EXTRA_SENSITIVE_GLOBS=                   # extra protected file names, e.g. *.kdbx,secrets.*
AUTO_ALLOW_EXTRA_TOOLS=                  # read-only tools to allow without asking, e.g. WebSearch
DISALLOWED_TOOLS=                        # tools Claude may not use at all
MAX_BUDGET_USD_PER_TURN=25               # stop a single prompt after this estimated spend
MAX_TURNS_PER_PROMPT=

# ---- Behaviour ------------------------------------------------------------------------------------------
NOTIFY_AFTER_SEC=60                      # @mention you when a reply took longer than this
IDLE_DISCONNECT_SEC=1800                 # stop a session's Claude Code process after this long without activity
STALL_NOTIFY_MIN=15                      # @mention when a running reply shows no activity this long
MAX_RUNNING_TURNS=4                      # replies running at once (others wait)
MAX_QUEUED_PER_THREAD=5                  # messages that may wait behind a running reply in one thread
UPDATE_INTERVAL_SEC=1.5                  # chat.update throttle (>= 1 s)
UPLOAD_MAX_MB=50                         # largest file `!upload` sends to Slack
INBOX_MAX_MB=20                          # largest file you can attach for Claude
INBOX_KEEP_DAYS=7                        # attached files are deleted after this many days
LOAD_CLAUDE_MD=1                         # add ~/.claude/CLAUDE.md and project CLAUDE.md files to the prompt
SQUEUE_PATH=                             # Slurm `squeue` for !status, if not on PATH
CLAUDE_CLI_PATH=                         # empty = the Claude Code CLI bundled with the Agent SDK (recommended)
SCRUB_SUBPROCESS_ENV=0                   # 1 = Claude Code env scrubbing (needs bubblewrap + socat)

# ---- Optional: long jobs (sac-job; Linux with systemd user services) -------------------------------
JOBS_ENABLED=                            # default: on when systemd-run is available
JOBS_POLL_SEC=15

# ---- Optional: terminal mirror (Linux; install hooks with deploy/install_hooks.py) --------------------
MIRROR_DIRS=                             # comma-separated; terminal sessions under these dirs are mirrored (empty = off)
MIRROR_CHANNEL=                          # private channel ID for mirrored threads (also in ALLOWED_CHANNEL_IDS)
MIRROR_USER=                             # Slack user ID to @mention when a terminal waits for permission

# ---- Paths (defaults are fine) ---------------------------------------------------------------------------
STATE_DIR=                               # ~/.local/state/slack-agent-controller
INBOX_DIR=                               # ~/.cache/slack-agent-controller/inbox
JOBS_DIR=                                # ~/.local/share/slack-agent-controller/jobs
MIRROR_SOCKET=                           # /run/user/<uid>/sac-mirror.sock
