# systemd --user unit for slack-agent-controller.
# Install:  cp deploy/slack-agent-controller.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#           systemctl --user enable --now slack-agent-controller
# Requires lingering (`loginctl show-user $USER | grep Linger` -> yes) to run without a login.
[Unit]
Description=Slack <-> Claude Code bot (Bedrock)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/slack-agent-controller
ExecStart=%h/slack-agent-controller/.venv/bin/python %h/slack-agent-controller/bot.py --env-file %h/.config/slack-agent-controller/env
Restart=on-failure
RestartSec=15
# Exit code 2 = configuration error: do not crash-loop, fix the env file.
RestartPreventExitStatus=2
Environment=PYTHONUNBUFFERED=1
# Child Claude CLI processes are in the same cgroup and are stopped with the bot.
KillMode=control-group
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
